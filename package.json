{
  "name": "image-prompt-builder",
  "version": "1.0.0",
  "description": "A Vue.js prompt builder for image generation",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:dist": "npm run build && electron-builder --publish=never",
    "electron:pack": "npm run build && electron-builder --dir",
    "build:icons": "node electron/scripts/build-icons.js"
  },
  "dependencies": {
    "bootstrap": "^5.3.2",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.0",
    "concurrently": "^9.2.1",
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "sass": "^1.69.5",
    "sharp": "^0.34.4",
    "terser": "^5.44.0",
    "vite": "^5.0.0",
    "wait-on": "^9.0.1",
    "@types/bun": "latest"
  },
  "build": {
    "appId": "com.imagepromptbuilder.app",
    "productName": "Image Prompt Builder",
    "icon": "electron/electron-assets/icons/icon.png",
    "directories": {
      "output": "electron/dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/dist-electron{,/**}"
    ],
    "mac": {
      "icon": "electron/electron-assets/icons/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "electron/electron-assets/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "private": true,
  "peerDependencies": {
    "typescript": "^5"
  }
}
